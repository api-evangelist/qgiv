            "url": "https://secure.qgiv.com/admin/api/customFields/list",
            "body": {
              "type": "form-urlencoded",
              "data": []
            }
          },
          "docs": "List all custom fields (Confirmed)"
        },
        {
          "info": {
            "name": "Create a custom field (Confirmed)",
            "type": "http"
          },

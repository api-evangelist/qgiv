            "body": {
              "type": "form-urlencoded",
              "data": []
            }
          },
          "docs": "Create a custom field (Confirmed)"
        },
        {
          "info": {
            "name": "Retrieve a single custom field (Confirmed)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://secure.qgiv.com/admin/api/customFields/:id",
            "params": [
              {
                "name": "id",
                "value": "",

            "params": [{ "name": "id", "value": "", "type": "path", "description": "Event ID." }],
            "body": { "type": "form", "data": { "token": "", "package": "{}" } }
          },
          "docs": "Updates an existing event."
        }
      ]
    },
    {
      "info": { "name": "Account Settings", "type": "folder" },
      "items": [
        {
          "info": { "name": "Get organization and form settings.", "type": "http" },
          "http": {
            "method": "POST",
            "url": "https://secure.qgiv.com/admin/api/account/settings.json",
            "body": { "type": "form", "data": { "token": "" } }
          },
          "docs": "Returns organization title/contact info and per-form settings."
        },
        {
          "info": { "name": "Update organization and form settings.", "type": "http" },
          "http": {
            "method": "POST",
            "url": "https://secure.qgiv.com/admin/api/account/settings.json",
            "body": { "type": "form", "data": { "token": "", "package": "{\"settings\":{\"organization\":{\"title\":\"My Org\",\"contactEmail\":\"info@example.org\"}}}" } }
          },
          "docs": "Updates organization and/or form settings."
        }
      ]
    },
    {
      "info": { "name": "Custom Fields", "type": "folder" },
      "items": [

            "url": "https://secure.qgiv.com/admin/api/customFields/:id.json",
            "params": [{ "name": "id", "value": "", "type": "path", "description": "Custom field ID." }],
            "body": { "type": "form", "data": { "token": "", "package": "{\"customfields\":[{\"id\":\"2811\",\"title\":\"Sweater size\"}]}" } }
          },
          "docs": "Updates an existing custom field."
        }
      ]
    },

{
  "info": {
    "name": "Qgiv API",
    "description": "Token-authenticated, form-scoped reporting and configuration API for Qgiv (now Bloomerang Fundraising) donation forms, events, and peer-to-peer campaigns. Base URL: https://secure.qgiv.com/admin/api. All requests are HTTP POST carrying a token field (and a package field of XML/JSON input for write operations); response format is selected by URL extension (.json or .xml).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://secure.qgiv.com/admin/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Get last N transactions",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": { "mode": "urlencoded", "urlencoded": [{ "key": "token", "value": "{{token}}" }] },
            "url": { "raw": "{{baseUrl}}/reporting/transactions/last/:limit.json", "host": ["{{baseUrl}}"], "path": ["reporting", "transactions", "last", ":limit.json"], "variable": [{ "key": "limit", "value": "10" }] },
            "description": "Returns the last [limit] transactions for the current form or organization."
          }
        },
        {
          "name": "Get transactions after ID",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": { "mode": "urlencoded", "urlencoded": [{ "key": "token", "value": "{{token}}" }] },
            "url": { "raw": "{{baseUrl}}/reporting/transactions/after/:id.json", "host": ["{{baseUrl}}"], "path": ["reporting", "transactions", "after", ":id.json"], "variable": [{ "key": "id", "value": "" }] },
            "description": "Returns transactions with IDs greater than the specified transaction ID."
          }
        },
        {
          "name": "Get transactions by date range",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": { "mode": "urlencoded", "urlencoded": [{ "key": "token", "value": "{{token}}" }] },
            "url": { "raw": "{{baseUrl}}/reporting/transactions/dates/01012012:12312012.json", "host": ["{{baseUrl}}"], "path": ["reporting", "transactions", "dates", "01012012:12312012.json"] },
            "description": "Returns transactions between begin and end dates (MMDDYYYY or MM-DD-YYYY)."
          }
        },
        {
          "name": "Get a single transaction",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": { "mode": "urlencoded", "urlencoded": [{ "key": "token", "value": "{{token}}" }] },
            "url": { "raw": "{{baseUrl}}/reporting/transactions/:id.json", "host": ["{{baseUrl}}"], "path": ["reporting", "transactions", ":id.json"], "variable": [{ "key": "id", "value": "" }] },
            "description": "Returns a single transaction by ID."
          }
        }
      ]
    },
